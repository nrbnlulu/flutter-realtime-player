<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Dart VM service (hot reload, DevTools) listens on a local socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="flutter_realtime_player_example">

        <activity
            android:name="dev.flutter.rs.RustActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/AndroidRunnerTheme">

            <!-- The Rust runner cdylib (lib<name>.so) that GameActivity loads. -->


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>
</manifest>
